# saasy-core environment variables
# NOTE: unlike the Rust services, Spring does not auto-load a .env file.
# Either export these before running:
#   set -a && source .env && set +a && make run
# or put local overrides in a gitignored
# src/main/resources/application-local.yml (the local profile that make run
# activates). application.yml supplies the defaults shown below.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=saasy-core-db
DB_USER=
DB_PASSWORD=

PORT=8082
GRPC_PORT=9092

# PKCS#8 PEM ES256 private key for signing session JWTs. Generate the pair:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 -out private.pem
#   openssl ec -in private.pem -pubout -out public.pem
# The public key goes to saasy-signal's JWT_PUBLIC_KEY.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...your key...
-----END PRIVATE KEY-----"

# Shared secret for admin endpoints (X-Admin-Key header)
ADMIN_API_KEY=change-me

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
